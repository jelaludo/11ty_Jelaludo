{% import "partials/palette.njk" as palette %}

<div class="immersive-gallery" data-gallery>
  {% for image in gallery %}
  <section 
    class="gallery-slide{% if loop.first %} gallery-slide--first{% endif %}"
    data-gallery-item
    data-title="{{ image.title }}"
    data-src="{% imgUrl src=image.src %}"
    data-alt="{{ image.alt }}"
    data-href="/gallery/{{ image.title | slug }}/"
  >
    <button
      class="gallery-slide__link"
      type="button"
      data-lightbox-trigger
      aria-label="Open {{ image.title }}"
    >
      <div class="gallery-slide__media">
        {% img
          src=image.src,
          alt=image.alt,
          className="gallery-slide__img",
          sizes="100vw"
        %}
      </div>
      {% if loop.first %}
      <div class="gallery-slide__bokeh-overlay">
        <p class="gallery-slide__cta">
          <span class="gallery-slide__cta-line">Scroll to</span>
          <span class="gallery-slide__cta-line">Explore</span>
        </p>
      </div>
      {% endif %}
    </button>
  </section>
  {% endfor %}
</div>

<section class="themes-lightbox" data-lightbox hidden>
    <button class="themes-lightbox__arrow themes-lightbox__arrow--prev" type="button" data-lightbox-prev aria-label="Previous image">
        <span>&lt;</span>
    </button>
    <img class="themes-lightbox__img" alt="" data-lightbox-img />
    <button class="themes-lightbox__arrow themes-lightbox__arrow--next" type="button" data-lightbox-next aria-label="Next image">
        <span>&gt;</span>
    </button>
    <div class="themes-lightbox__actions">
        <a class="themes-lightbox__link" href="/gallery/" data-lightbox-gallery>Gallery</a>
        <a class="themes-lightbox__link" href="" data-lightbox-link>Details</a>
        <button class="themes-lightbox__copy" type="button" data-lightbox-copy>Link</button>
    </div>
</section>